import z from 'zod'

export const <%= pascalName %>Query = z.object({
  page: z.coerce.number().int().min(1).default(1),
  limit: z.coerce.number().int().min(1).max(100).default(10),
  search: z.string().optional()
})

export const <%= pascalName %>CreateSchema = z.object({
  name: z
    .string({
      message: 'Name is required'
    })
    .min(2, { message: 'Name is too short' })
    .max(255, { message: 'Name is too long' }),
  price: z.coerce
    .number({
      message: 'Price is required'
    })
    .min(0, { message: 'Price must be a positive number' })
})

export const <%= pascalName %>ParamsSchema = z.object({
  id: z.coerce.number().int().min(1, { message: 'Invalid <%= camelName %> ID' })
})

export const <%= pascalName %>ResponseSchema = z.object({
  id: z.number().int(),
  name: z.string(),
  description: z.string().optional(),
  price: z.number()
})

export type <%= pascalName %>Response = z.infer<typeof <%= pascalName %>ResponseSchema>